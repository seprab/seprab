---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../lib/data';
---

<BaseLayout title="Projects — SepraB" description="Projects and shipped titles Sergio Prada worked on: simulators, VR, educational apps, and Unity engine support credits.">
  <h1>Projects & Credits</h1>
  <p>
    A selection of projects I participated in. Much of my work is covered by NDAs or has no
    public reference, so this is the visible part — my <a href="https://www.linkedin.com/in/seprab/">LinkedIn</a> and <a href="/cv/">CV</a> tell the fuller story.
  </p>

  <ul class="post-grid projects-grid">
    {projects.map((p) => (
      <li class:list={['card', { 'has-cover': !!p.image }]}>
        {p.image && <img class="cover" src={p.image} alt="" loading="lazy" />}
        <strong class="title">{p.title}</strong>
        <p class="desc">{p.description}</p>
        {(p.video || p.link) && (
          <div class="tags">
            {p.video && <a class="chip" href={p.video}>▶ Watch video</a>}
            {p.link && <a class="chip" href={p.link}>Learn more ↗</a>}
          </div>
        )}
      </li>
    ))}
  </ul>
</BaseLayout>
