---
import { cv } from '../lib/data';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <span>© {year} {cv.basics.name}</span>
    <span>
      {cv.basics.links.map((l, i) => (
        <>
          {i > 0 && ' · '}
          <a href={l.url}>{l.label}</a>
        </>
      ))}
      {' · '}
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>
